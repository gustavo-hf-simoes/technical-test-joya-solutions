# Modelo para um .env local (copie para .env; o .env está no .gitignore).
# Tudo é opcional: sem .env, o docker-compose.yml usa estes mesmos valores de
# DESENVOLVIMENTO. Em produção, defina valores próprios e fortes.
# Sem aspa simples e sem "$" (o compose interpreta). Nenhuma senha pode conter o nome do
# próprio login (joya_app, claude_mcp): o SQL Server recusa.

# Senha do sa: só o db e o db-init usam.
MSSQL_SA_PASSWORD=Joya_Dev_Sa_2026

# Login joya_app (API): SELECT, INSERT, UPDATE.
APP_SQL_PASSWORD=Pedidos_Api_2026

# Login claude_mcp (MCP): somente leitura. O .mcp.json lê a mesma variável. A senha não pode conter o nome do login (erro 33064).
MCP_SQL_PASSWORD=Mcp_Leitura_2026
